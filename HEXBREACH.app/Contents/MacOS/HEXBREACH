#!/bin/sh
# Start HEXBREACH from Finder, the Dock or Spotlight: no terminal needed.
# The game is the folder this app sits in; if the app has been moved (to the
# Desktop, say), it is where the app was made.
here="$(cd "$(dirname "$0")/../../.." && pwd)"
[ -x "$here/run.sh" ] || here="/Users/charliesweetland/Code/hexbreach"
exec "$here/run.sh"
